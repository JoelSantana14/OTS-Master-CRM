rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /crm_state/{document} {
      allow read, write: if true;
    }
    
    match /deletion_audit_logs/{document} {
      allow read, write: if true;
    }

    match /users/{document} {
      allow read, write: if true;
    }
  }
}
